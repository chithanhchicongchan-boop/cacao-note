{
  "name": "cacao-note",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cacao-note-db",
      "database_id": "REPLACE_WITH_REAL_DATABASE_ID"
    }
  ]
}
